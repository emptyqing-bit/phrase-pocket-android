<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/floating_panel_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/floating_input_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/floating_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/on_surface_variant" />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/floating_radio_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/tab_words"
            android:textColor="@color/on_surface" />

        <RadioButton
            android:id="@+id/floating_radio_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/tab_notes"
            android:textColor="@color/on_surface" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/floating_collapse"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/floating_collapse"
            android:textColor="@color/on_surface_variant" />

        <Button
            android:id="@+id/floating_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/save" />
    </LinearLayout>

</LinearLayout>
